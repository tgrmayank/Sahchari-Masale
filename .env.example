
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- SEO (optional but recommended) ----
# Your live domain, no trailing slash. Used for canonical URLs, sitemap, schema.
NEXT_PUBLIC_SITE_URL=https://sahcharimasale.in
# Google Search Console -> "HTML tag" verification: paste ONLY the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification (optional)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---- Admin push notifications (Pushy) ----
# App ID is public. The two SECRET values below are SERVER ONLY: put them in Vercel
# Environment Variables, never in GitHub and never with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_PUSHY_APP_ID=6af4c51bd819808c52e4feca
PUSHY_SECRET_API_KEY=YOUR-PUSHY-SECRET-API-KEY
PUSH_WEBHOOK_SECRET=YOUR-RANDOM-SECRET-SAME-AS-IN-supabase-push-setup.sql
